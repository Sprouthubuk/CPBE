---
import Layout from "../layouts/Layout.astro";
import CheckoutView from "../islands/CheckoutView";
import PostalBox from "../components/PostalBox.astro";
const { me, site } = Astro.locals;
const buy = Astro.url.searchParams.get("buy");
---
<Layout title="Review & Pay" noindex header="secure" headerBack={buy ? "/competitions" : "/basket"} bottomNav={false} footer={false}>
  <section class="sec" style="padding-top:16px"><div class="narrow stack g16" style="max-width:620px">
    <div class="steps v9-rise" aria-label="Step 2 of 3"><span class="on"></span><span class="on"></span><span></span></div>
    <h1 class="h2 v9-rise v9-d1">Review &amp; <span class="np v9-flicker">Pay</span></h1>
    <CheckoutView client:load buy={buy} walletPence={me?.wallet.totalPence ?? 0} minCardPence={site.minCardPence} minDepositPence={site.minDepositPence} />
    <PostalBox />
    <div class="hint" style="text-align:center">Card payments secured by Cashflows · 18+ UK only</div>
  </div></section>
</Layout>
