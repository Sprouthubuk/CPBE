---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import BasketView from "../islands/BasketView";
import PostalBox from "../components/PostalBox.astro";
---
<Layout title="Your Basket" noindex bottomNav={false}>
  <section class="sec" style="padding-top:16px"><div class="wrap stack g20">
    <a href="/competitions" class="row g8 mob" style="color:#C9D3CE;text-decoration:none;font-weight:800;font-size:14px;min-height:44px"><Icon name="back" size={18} />Keep Browsing</a>
    <div class="v9-rise"><h1 class="h1">Your <span class="np v9-flicker">Basket</span></h1></div>
    <BasketView client:load signedIn={!!Astro.locals.me} vaultCase={!!Astro.locals.site?.vaultCase?.available} />
    <PostalBox />
  </div></section>
</Layout>
