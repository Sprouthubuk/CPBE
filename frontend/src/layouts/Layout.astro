---
import "../styles.css";
import Header from "../components/Header.astro";
import BottomNav from "../components/BottomNav.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { BRAND, ldJson, organisationLd, pageTitle, websiteLd } from "../lib/seo";
interface Props {
  title: string;
  description?: string;
  active?: string;
  header?: "main" | "auth" | "secure" | "menu";
  headerBack?: string;
  headerTitle?: string;
  bottomNav?: boolean;
  footer?: boolean;
  /** Only the page itself: no header, footer, tab bar or cookie banner (the admin's game previewer frames it). */
  bare?: boolean;
  noindex?: boolean;
  /** The picture shown when the page is shared (Facebook, WhatsApp); the logo when not given. */
  shareImage?: string | null;
  /** Use this whole title in search results instead of "Title | Brand Name". */
  fullTitle?: string;
  /** Query keys that make a different page worth its own search result (e.g. ["type"] on /competitions). */
  canonicalKeys?: string[];
  /** Structured data (schema.org) for this page. */
  jsonLd?: Record<string, unknown>[];
}
const { title, description = "UK prize competitions: instant win games and live draws for cash, tech and more. 18+ UK only, free postal entry on every competition.", active = "", header = "main", headerBack, headerTitle, bottomNav = true, footer = true, noindex = false, bare = false, shareImage = null, fullTitle, canonicalKeys = [], jsonLd = [] } = Astro.props;
const full = fullTitle ?? pageTitle(title);
const robots = noindex || import.meta.env.PUBLIC_SEARCH_INDEXING !== "on" ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const base = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, base);
for (const k of canonicalKeys) {
  const v = Astro.url.searchParams.get(k);
  if (v) canonicalUrl.searchParams.set(k, v);
}
const canonical = canonicalUrl.toString();
const origin = new URL(base).origin;
const socials = Astro.locals.site?.socials;
// Every page says who we are; pages add their own (breadcrumbs, FAQs).
const ld = [organisationLd(origin, [socials?.instagram, socials?.facebook]), websiteLd(origin), ...jsonLd];
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{full}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={robots}>
  <meta name="theme-color" content="#07090A">
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {verification && <meta name="google-site-verification" content={verification}>}
  <meta property="og:site_name" content={BRAND}>
  <meta property="og:locale" content="en_GB">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={full}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={new URL(shareImage || "/logo.png", base).toString()}>
  <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"}>
  <meta name="twitter:title" content={full}>
  <meta name="twitter:description" content={description}>
  {!noindex && !bare && <script type="application/ld+json" set:html={ldJson(ld)} />}
</head>
<body data-signed-in={Astro.locals.me ? "1" : "0"}>
  <a class="skip" href="#main">Skip to content</a>
  <div class={`g ${bottomNav && !bare ? "has-bn" : ""}`}>
    {!bare && <Header active={active} variant={header} back={headerBack} title={headerTitle} />}
    <main id="main"><slot /></main>
    {footer && !bare && <Footer />}
    {bottomNav && !bare && <BottomNav active={active} />}
  </div>
  {!bare && <CookieBanner />}
  <script>
    // SOW 2.18: A/B tests on elements marked data-exp (only with consent, or signed in).
    import { runExperiments } from "../lib/experiments";
    void runExperiments(document.body.dataset.signedIn === "1");
  </script>
  {Astro.locals.site?.translation && (
    <>
      {/* SOW 2.17 / amendment 9: the language switcher, on every page (checkout, account, games and messages too).
          Weglot is a third party that receives the page's text, so it loads only once the visitor asks for a
          translation ("Translate This Site" in the footer, remembered in this browser). Personal details (names,
          email addresses, balances) carry data-wg-notranslate / translate="no", so they are never sent to it, and
          input values are never translated. data-weglot-ok stays as a switch for any page that must opt out. */}
      <script is:inline data-weglot-key={Astro.locals.site.translation.weglotKey} data-weglot-ok="1">
        (function () {
          var me = document.currentScript, key = me.dataset.weglotKey, ok = me.dataset.weglotOk === "1", started = false;
          function start() {
            if (started || !ok) return;
            started = true;
            var s = document.createElement("script");
            s.src = "https://cdn.weglot.com/weglot.min.js";
            s.onload = function () { if (window.Weglot) window.Weglot.initialize({ api_key: key }); };
            document.head.appendChild(s);
          }
          var asked = false;
          try { asked = localStorage.getItem("cp-translate") === "1"; } catch (e) {}
          if (asked) start();
          document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll("[data-translate]").forEach(function (b) {
              if (!ok || asked) return;
              b.hidden = false;
              b.addEventListener("click", function () {
                try { localStorage.setItem("cp-translate", "1"); } catch (e) {}
                b.hidden = true;
                start();
              });
            });
          });
        })();
      </script>
    </>
  )}
  <script>
    import { readBasket, onBasketChange } from "../lib/basket";
    import { remaining, endsIn } from "../lib/time";
    // Basket badge in the header.
    const paint = () => {
      const n = readBasket().length;
      document.querySelectorAll<HTMLElement>("[data-basket-count]").forEach((el) => {
        el.hidden = n === 0;
        el.textContent = String(n);
      });
      // The visible number is part of the link's name (WCAG 2.5.3 Label in Name).
      document.querySelectorAll<HTMLElement>("[data-basket-link]").forEach((a) => a.setAttribute("aria-label", n ? `Basket, ${n} ${n === 1 ? "item" : "items"}` : "Basket"));
    };
    paint();
    onBasketChange(paint);
    // Every countdown on the page.
    const pad = (n: number) => String(n).padStart(2, "0");
    const tick = () => {
      document.querySelectorAll<HTMLElement>("[data-countdown]").forEach((el) => {
        const r = remaining(el.dataset.countdown!);
        const set = (u: string, v: number) => {
          const b = el.querySelector<HTMLElement>(`[data-u="${u}"]`);
          if (b && b.textContent !== pad(v)) b.textContent = pad(v);
        };
        set("d", r.days); set("h", r.hours); set("m", r.mins); set("s", r.secs);
      });
      document.querySelectorAll<HTMLElement>("[data-ends]").forEach((el) => {
        const txt = endsIn(el.dataset.ends!);
        const node = el.lastChild;
        if (node && node.nodeType === 3 && node.textContent !== txt) node.textContent = txt;
      });
    };
    tick();
    setInterval(tick, 1000);
  </script>
</body>
</html>
